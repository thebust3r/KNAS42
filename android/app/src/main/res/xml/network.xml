<?xml version="1.0" encoding="utf-8"?>
<!-- KNAS runs on your home network over plain http (like http://192.168.1.50:8642), so allow that. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
